# ---------------------------------------------------------------------------
# Public site URL (required in production for OG tags + canonical URLs)
# ---------------------------------------------------------------------------
# Leave unset locally — layout falls back to http://localhost:3000. In prod,
# set to your deployed origin (e.g. https://lockkaro.vercel.app) so social
# scrapers resolve /opengraph-image and every canonical URL correctly.
# NEXT_PUBLIC_SITE_URL=https://lockkaro.vercel.app

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
# "mock"     — local-only. Records in localStorage, files in IndexedDB.
#              No account, no network, nothing leaves the browser. (default)
# "supabase" — real backend. Requires the three variables below.
NEXT_PUBLIC_DATA_MODE=mock

# ---------------------------------------------------------------------------
# Supabase — required only when NEXT_PUBLIC_DATA_MODE=supabase
# ---------------------------------------------------------------------------
# Project URL and anon key. Both are safe to expose to the browser: every
# table has row level security on, so the anon key can only reach rows that
# belong to the signed-in user.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses row level security — server-side only, never
# prefixed with NEXT_PUBLIC_, never committed. Nothing in the app needs it
# today; it is here for migrations and future background jobs.
# SUPABASE_SERVICE_ROLE_KEY=
