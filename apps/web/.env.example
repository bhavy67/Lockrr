# ---------------------------------------------------------------------------
# Public site URL (required in production for OG tags + canonical URLs)
# ---------------------------------------------------------------------------
# Leave unset locally — layout falls back to http://localhost:3000. In prod,
# set to your deployed origin (e.g. https://lockkaro.vercel.app) so social
# scrapers resolve /opengraph-image and every canonical URL correctly.
# NEXT_PUBLIC_SITE_URL=https://lockkaro.vercel.app
