{
  "name": "lockerr",
  "version": "0.1.0",
  "private": true,
  "description": "Lockerr — a private personal document vault",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @lockerr/web dev",
    "build": "pnpm --filter @lockerr/web build",
    "start": "pnpm --filter @lockerr/web start",
    "lint": "pnpm --filter @lockerr/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @lockerr/web test",
    "test:watch": "pnpm --filter @lockerr/web test:watch",
    "e2e": "pnpm --filter @lockerr/web e2e",
    "e2e:install": "pnpm --filter @lockerr/web e2e:install"
  },
  "engines": {
    "node": ">=20"
  }
}
